{
  "name": "@dewtix/contracts",
  "version": "1.0.12",
  "description": "Protobuf defs and gen ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gen/ts/auth": {
      "types": "./gen/ts/auth.d.ts",
      "default": "./gen/ts/auth.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "protoc -I ./proto ./proto/*.proto --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit"
  },
  "files": [
    "gen",
    "proto",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dewtix/contracts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.1.16",
    "rxjs": "^7.8.2",
    "ts-proto": "^2.11.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
